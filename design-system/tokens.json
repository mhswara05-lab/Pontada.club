{
  "id": "pontada-modern-v1",
  "version": "1.0.1",
  "status": "locked",
  "scope": "Spesifikasi desain; belum diterapkan pada web produksi",
  "brand": {
    "name": "pontada.",
    "logo": "assets/pontada-logo-master.png",
    "logoRecreationAllowed": false,
    "logoAspectRatio": "preserve",
    "font": "Manrope",
    "fontFile": "fonts/Manrope-Variable.ttf",
    "subtitle": "PICKLEBALL CLUB",
    "subtitlePlacement": "Di bawah wordmark pontada.; gunakan sebagai bagian dari master gambar"
  },
  "colors": {
    "primary": "#15392C",
    "ink": "#142B24",
    "accent": "#D8F5A2",
    "background": "#F7F9F4",
    "surface": "#FFFFFF",
    "textSecondary": "#4F6258",
    "border": "#D5DFD6",
    "danger": "#A82E2E",
    "focus": "#326B50"
  },
  "typography": {
    "family": "Manrope",
    "body": {
      "size": 20,
      "weight": 500,
      "lineHeight": 1.5
    },
    "support": {
      "size": 18,
      "weight": 500,
      "lineHeight": 1.5
    },
    "navigation": {
      "size": 20,
      "weight": 650,
      "lineHeight": 1.4
    },
    "button": {
      "size": 20,
      "weight": 700,
      "lineHeight": 1.4
    },
    "headingDesktop": {
      "size": 40,
      "weight": 750,
      "lineHeight": 1.2
    },
    "headingMobile": {
      "size": 32,
      "weight": 750,
      "lineHeight": 1.25
    },
    "sectionHeading": {
      "size": 26,
      "weight": 700,
      "lineHeight": 1.3
    },
    "scoreDesktop": {
      "size": 88,
      "weight": 800,
      "lineHeight": 1.1
    },
    "scoreMobile": {
      "size": 80,
      "weight": 800,
      "lineHeight": 1.1
    },
    "minimumTextSize": 18
  },
  "layout": {
    "spacingUnit": 8,
    "pageWidthMax": 1280,
    "desktopGutter": 32,
    "mobileGutter": 20,
    "cardPaddingDesktop": 24,
    "cardPaddingMobile": 20,
    "cardRadius": 20,
    "buttonRadius": 14,
    "buttonMinHeight": 56,
    "touchTargetMin": 56,
    "controlGapMin": 12,
    "desktopBreakpoint": 1024,
    "tabletBreakpoint": 720
  },
  "components": {
    "primaryButton": {
      "background": "primary",
      "text": "surface"
    },
    "limeButton": {
      "background": "accent",
      "text": "ink"
    },
    "secondaryButton": {
      "background": "surface",
      "text": "primary",
      "border": "border"
    },
    "activeNavigation": {
      "background": "accent",
      "text": "ink"
    },
    "card": {
      "background": "surface",
      "shadow": "0 8px 24px rgba(21,57,44,.06)"
    }
  },
  "navigation": {
    "public": [
      "Beranda",
      "Jadwal",
      "Klasemen"
    ],
    "managementEntry": "Masuk Pengelola",
    "playerEntry": "Daftar Pemain",
    "scoreEntry": "Catat Skor"
  },
  "accessibility": {
    "textContrastMinimum": 4.5,
    "largeTextContrastMinimum": 3,
    "showIconLabels": true,
    "avoidColorOnlyMeaning": true,
    "visibleFocus": true,
    "respectReducedMotion": true,
    "preserve200PercentZoom": true,
    "horizontalPageOverflowAllowed": false,
    "successLabel": "Skor sudah tersimpan",
    "pendingLabel": "Skor belum tersimpan — menunggu koneksi"
  },
  "changePolicy": "Logo, font, warna utama, token ukuran, dan struktur navigasi hanya direvisi atas permintaan eksplisit pengguna; jangan diganti saat mengerjakan fitur lain."
}
